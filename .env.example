# Browser-safe Supabase values
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
VITE_AUTH_DOMAIN=users.nexora.app

# Server-only values used by the Render/Node API. Never expose the service role key in VITE_* variables.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
NEXORA_AUTH_DOMAIN=users.nexora.app

# Render automatically provides PORT. Do not hard-code it in production.
# PORT=10000
