{
  "name": "nexora-collect",
  "version": "1.3.2",
  "private": true,
  "description": "نكسورا للتحصيل - نظام إدارة المندوبين والعملاء والتحصيلات",
  "main": "electron/main.cjs",
  "author": "Nexora Team",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build:web": "vite build",
    "build": "vite build && electron-builder --dir",
    "dist": "vite build && electron-builder",
    "dist:win": "vite build && electron-builder --win nsis portable --x64 --publish never",
    "typecheck": "tsc --noEmit",
    "test:build": "npm run typecheck && npm run build:web",
    "smoke": "electron . --smoke-test",
    "verify": "npm run typecheck && npm run build:web && npm run smoke",
    "dist:win:unsigned": "vite build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win nsis portable --x64 --publish never",
    "dist:win:setup": "vite build && electron-builder --win nsis --x64 --publish never",
    "dist:win:portable": "vite build && electron-builder --win portable --x64 --publish never",
    "dev:web": "vite",
    "dev:vercel": "npx vercel dev",
    "verify:web": "npm run typecheck && npm run build:web",
    "dev:render": "cross-env NODE_ENV=development tsx server/render.ts",
    "start:render": "tsx server/render.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.0.0",
    "express": "4.21.2",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.1",
    "recharts": "^2.15.0",
    "tsx": "^4.19.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vercel/node": "^5.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "typescript": "^5.7.2",
    "vite": "^6.0.6",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.nexora.collect",
    "productName": "Nexora Collect",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "node_modules/sql.js/dist/sql-wasm.wasm",
        "to": "sql-wasm.wasm"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Nexora Collect",
      "uninstallDisplayName": "Nexora Collect",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "artifactName": "Nexora-Collect-Setup-${version}-${arch}.${ext}",
      "installerHeaderIcon": "build/icon.ico"
    },
    "copyright": "Copyright © 2026 Nexora Team",
    "portable": {
      "artifactName": "Nexora-Collect-Portable-${version}-${arch}.${ext}"
    }
  },
  "optionalDependencies": {
    "bcryptjs": "^3.0.2",
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8",
    "pdf-lib": "^1.17.1",
    "sql.js": "^1.12.0"
  }
}
